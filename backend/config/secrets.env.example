# Copy this file to secrets.env and fill in real values.
# secrets.env is git-ignored; never commit real credentials.

# Always required: embeddings and the pgvector index are OpenAI-only, because
# the vector columns are sized for text-embedding-3-small (1536 dims).
OPENAI_API_KEY=sk-...

# GH#106 — optional. The key for the QUERY STAGE when llm.base_url (or
# $LLM_BASE_URL) points at another OpenAI-compatible provider: OpenRouter,
# Groq, DeepSeek, Together, Gemini's compat layer, a local Ollama/vLLM server.
# Unset → OPENAI_API_KEY is used, so a plain OpenAI setup needs nothing here.
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-v1-...

# Optional. The back-translation judge's own key (`bird --trust-eval`), for a
# generator and judge on DIFFERENT providers. Unset → LLM_API_KEY.
# JUDGE_API_KEY=sk-...

PG_DB=FYP
PG_USER=postgres
PG_PASSWORD=your_postgres_password_here
PG_HOST=127.0.0.1
PG_PORT=5432
